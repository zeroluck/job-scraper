[Unit]
Description=CT337 backup/restore operation monitor and verified alerts
After=network-online.target
[Service]
Type=oneshot
ExecStart=/usr/bin/python3 -I /opt/autonomy337/autonomy.py monitor --config /etc/autonomy337/monitor/config.json
TimeoutStartSec=120
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/autonomy337-monitor
LimitCORE=0
